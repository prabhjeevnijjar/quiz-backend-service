{
  "name": "quiz-backend",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --filter api-gateway dev",
    "build": "pnpm --filter api-gateway build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v --remove-orphans",
    "docker:build": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f api-gateway",
    "docker:logs:all": "docker compose logs -f",
    "health": "curl -s http://localhost:3000/health | jq .",
    "db:migrate": "pnpm --filter @quiz/database migrate:up",
    "db:migrate:down": "pnpm --filter @quiz/database migrate:down",
    "db:create-migration": "pnpm --filter @quiz/database migrate:create"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.5.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
