# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# In development both pools point to the same Postgres container.
# In production PG_READ_HOST should point to a read replica.
PG_WRITE_HOST=localhost
PG_READ_HOST=localhost
PG_PORT=5432
PG_DATABASE=quiz
PG_USER=quiz_admin
PG_PASSWORD=quiz_secret_dev
PG_WRITE_POOL_MAX=20
PG_READ_POOL_MAX=40

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://quiz_user:quiz_pass@localhost:5672/
# management console on my mac
RABBITMQ_DEFAULT_USER=quiz_user
RABBITMQ_DEFAULT_PASS=quiz_pass

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=thisisisaaverylargesamplekeyforjwtsecret

# ─── Seeded Admin Credentials ───────────────────────────────────────────────
ADMIN_EMAIL=admin@quizplatform.com
ADMIN_PASSWORD=super_secret_admin_password_123
