# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://quiz_user:quiz_pass@localhost:5672/

# ─── Email ──────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
# Get a key from https://resend.com — leave blank to fail fast at startup.
RESEND_API_KEY=
EMAIL_FROM=Quiz Platform <onboarding@resend.dev>
EMAIL_PREFETCH=10
