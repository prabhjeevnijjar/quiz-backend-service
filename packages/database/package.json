{
  "name": "@quiz/database",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "DATABASE_URL=${DATABASE_URL:-postgres://quiz_admin:quiz_secret_dev@localhost:5432/quiz} node-pg-migrate up",
