# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# In development both pools point to the same Postgres container.
# In production PG_READ_HOST should point to a read replica.
PG_WRITE_HOST=postgres
PG_READ_HOST=postgres
PG_PORT=5432
PG_DATABASE=quiz
PG_USER=quiz_admin
PG_PASSWORD=quiz_secret_dev
PG_WRITE_POOL_MAX=20
PG_READ_POOL_MAX=40

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://quiz_user:quiz_pass@rabbitmq:5672/

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-real-secret-at-least-32-chars
